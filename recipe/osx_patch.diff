diff --git a/wrappers/python/build.py.in b/wrappers/python/build.py.in
index cc7ef6e..ee808a5 100755
--- a/wrappers/python/build.py.in
+++ b/wrappers/python/build.py.in
@@ -44,7 +44,11 @@ pyargs += " " + sysconfig.get_config_var("LIBM")
 
 
 ## Assemble the compile & link command
-compile_cmd = "  ".join([os.environ.get("CXX", "g++"), "-shared -fPIC",
+# Use the configured CXX rather than the bare compiler name baked into
+# sysconfig's LDCXXSHARED. As of clang v21, conda-forge's sysroot handling
+# lives in per-driver clang config files, so only the target-prefixed
+# driver in CXX can find the SDK and libc++ headers.
+compile_cmd = "  ".join([os.environ.get("CXX", "clang++"), "-bundle -undefined dynamic_lookup", "-std=c++11",
                          "-o", srcname.replace(".cpp", ".so"),
                          srcpath, incargs, cmpargs, linkargs, libargs, pyargs])
 print("Build command =", compile_cmd)
